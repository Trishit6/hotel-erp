const mysql = require('mysql2/promise');
const pool = await mysql.createPool({
  host: '127.0.0.1',
  port: 3307,
  user: 'root',
  password: 'Pribca@2026',
  database: 'rivr_hotel'
});

// Housekeeping tasks columns
const [hk] = await pool.query(
  "SELECT COLUMN_NAME, COLUMN_TYPE, IS_NULLABLE, COLUMN_DEFAULT FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'housekeeping_tasks' ORDER BY ORDINAL_POSITION"
);
console.log('HK_COLS=' + JSON.stringify(hk));

// Inventory columns
const [inv] = await pool.query(
  "SELECT COLUMN_NAME, COLUMN_TYPE, IS_NULLABLE, COLUMN_DEFAULT FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'inventory' ORDER BY ORDINAL_POSITION"
);
console.log('INV_COLS=' + JSON.stringify(inv));

// System settings columns
const [ss] = await pool.query(
  "SELECT COLUMN_NAME, COLUMN_TYPE, IS_NULLABLE, COLUMN_DEFAULT FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'system_settings' ORDER BY ORDINAL_POSITION"
);
console.log('SS_COLS=' + JSON.stringify(ss));

// Migration history
const [migs] = await pool.query(
  "SELECT filename, applied_at FROM schema_migrations ORDER BY filename"
);
console.log('MIGS=' + JSON.stringify(migs));

// Foreign keys
const [fks] = await pool.query(
  "SELECT TABLE_NAME, CONSTRAINT_NAME, COLUMN_NAME, REFERENCED_TABLE_NAME, REFERENCED_COLUMN_NAME, DELETE_RULE, UPDATE_RULE FROM information_schema.KEY_COLUMN_USAGE WHERE TABLE_SCHEMA = DATABASE() AND REFERENCED_TABLE_NAME IS NOT NULL"
);
console.log('FKS=' + JSON.stringify(fks));

console.log('DONE');

pool.end();