# API runtime
NODE_ENV=development
PORT=4000
# Explicit frontend origin allowed by CORS (comma-separated list).
WEB_ORIGIN=http://localhost:5173
# Public base URL of the API (used in docs only).
API_PUBLIC_URL=http://localhost:4000

# Database (MariaDB 10.6+ / MySQL 5.7+ compatible)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rivr_hotel
# Separate database used by the integration test suite.
DB_TEST_NAME=rivr_hotel_test

# Sessions / security
# 32+ random bytes, e.g. `openssl rand -hex 32`. Required in production.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=12
COOKIE_NAME=rivr_session
# Set to true only when serving over HTTPS.
COOKIE_SECURE=false

# Bootstrap
# Dev-only: allows POST /api/admin/dev/reset to reseed the database.
ALLOW_DEMO_RESET=true

# Optional extra demo admin used by `pnpm db:seed`.
# The demo seed itself also creates `admin@admin.com` / `password` for local
# development, along with role demo accounts whose password is `password`.
# Set both fields only when you want an additional admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=RIVR Administrator
