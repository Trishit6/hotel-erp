{
  "name": "rivr-hotel-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "dev:api": "pnpm --filter @rivr/api dev",
    "build:api": "pnpm --filter @rivr/api build",
    "typecheck:api": "pnpm --filter @rivr/api typecheck",
    "test:api": "pnpm --filter @rivr/api test",
    "db:migrate": "pnpm --filter @rivr/api db:migrate",
    "db:seed": "pnpm --filter @rivr/api db:seed",
    "db:reset": "pnpm --filter @rivr/api db:reset",
    "create-admin": "pnpm --filter @rivr/api create-admin"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "gsap": "^3.15.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
